# Public (shipped to the browser)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Canonical origin, used for metadataBase. Production: https://www.cincysports.xyz
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Optional. Google Search Console HTML-tag token (the content value), for domain verification.
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
# Optional. Web Push public key (87 characters). Push alerts need this AND VAPID_PRIVATE_KEY.
# Generate a pair with: pnpm exec web-push generate-vapid-keys --json
NEXT_PUBLIC_VAPID_PUBLIC_KEY=

# Server-only secrets: never prefix with NEXT_PUBLIC_
SUPABASE_SECRET_KEY=
CRON_SECRET=
# Weekly digest email. RESEND_API_KEY is optional locally (sending then reports email_not_configured).
RESEND_API_KEY=
# 32+ random characters (openssl rand -base64 32). Signs unsubscribe links.
DIGEST_SIGNING_SECRET=
# Optional. Defaults to "Cincy's All-Sports League <league@cincysports.xyz>".
DIGEST_FROM=
# Optional. Web Push private key (43 characters), the other half of NEXT_PUBLIC_VAPID_PUBLIC_KEY.
# Use a throwaway pair locally, never the production one. Rotating the production pair makes
# every member turn alerts back on.
VAPID_PRIVATE_KEY=
# Optional. Contact push services see: a https:// or mailto: address. Defaults to https://www.cincysports.xyz
VAPID_SUBJECT=
