# Public (shipped to the browser)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Canonical origin, used for metadataBase. Production: https://www.cincysports.xyz
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Optional. Google Search Console HTML-tag token (the content value), for domain verification.
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=

# Server-only secrets: never prefix with NEXT_PUBLIC_
SUPABASE_SECRET_KEY=
CRON_SECRET=
# Weekly digest email. RESEND_API_KEY is optional locally (sending then reports email_not_configured).
RESEND_API_KEY=
# 32+ random characters (openssl rand -base64 32). Signs unsubscribe links.
DIGEST_SIGNING_SECRET=
# Optional. Defaults to "Cincy's All-Sports League <league@cincysports.xyz>".
DIGEST_FROM=
